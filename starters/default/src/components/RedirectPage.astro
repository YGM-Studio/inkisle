---
import { absoluteUrl, siteConfig, sitePath } from "../config";

type Props = {
  to: string;
  title?: string;
};

const { to, title = siteConfig.title } = Astro.props;
const canonical = absoluteUrl(to);
const target = sitePath(to);
---

<!doctype html>
<html lang={siteConfig.defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={sitePath(siteConfig.brand.favicon)} />
    <title>{title}</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <a href={target}>Continue to {target}</a>
  </body>
</html>
