---
import { absoluteUrl, siteConfig } from "../config";

type Props = {
  to: string;
  title?: string;
};

const { to, title = siteConfig.title } = Astro.props;
const canonical = absoluteUrl(to);
---

<!doctype html>
<html lang={siteConfig.defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={siteConfig.brand.favicon} />
    <title>{title}</title>
    <script is:inline define:vars={{ to }}>
      window.location.replace(to);
    </script>
  </head>
  <body>
    <a href={to}>Continue to {to}</a>
  </body>
</html>
