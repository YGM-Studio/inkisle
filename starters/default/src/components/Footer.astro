---
import { getLocaleBase, getSiteDescription, siteConfig } from "../config";

type Props = {
  locale: string;
};

const { locale } = Astro.props;
const isZh = locale === "zh";
const siteDescription = getSiteDescription(locale);
const icpFiling = siteConfig.filing.icp?.number?.trim()
  ? {
      number: siteConfig.filing.icp.number.trim(),
      url: siteConfig.filing.icp.url || "https://beian.miit.gov.cn/"
    }
  : undefined;
const footerLinks = [
  { href: `${getLocaleBase(locale)}/search/`, label: isZh ? "搜索" : "Search" },
  { href: "/rss.xml", label: "RSS" },
  { href: "/feed.json", label: "JSON Feed" },
  { href: "/llms.txt", label: "llms.txt" }
];
---

<footer class="site-footer">
  <div>
    <strong>{siteConfig.title}</strong>
    <p>{siteDescription}</p>
  </div>

  <nav aria-label="Footer">
    {footerLinks.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <small>
    <span>&copy; {new Date().getFullYear()} {siteConfig.author.name}. {isZh ? "由 InkIsle 发布。" : "Published with InkIsle."}</span>
    {
      icpFiling && (
        <a href={icpFiling.url} target="_blank" rel="noopener noreferrer">
          {icpFiling.number}
        </a>
      )
    }
  </small>
</footer>
