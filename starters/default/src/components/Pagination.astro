---
import { getLocaleBase } from "../config";

type Props = {
  locale: string;
  currentPage: number;
  totalPages: number;
};

const { locale, currentPage, totalPages } = Astro.props;
const isZh = locale === "zh";
const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);

function pageHref(page: number) {
  if (page <= 1) {
    return `${getLocaleBase(locale)}/`;
  }

  return `${getLocaleBase(locale)}/page/${page}/`;
}
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label={isZh ? "文章分页" : "Post pagination"}>
      <a
        class:list={["pagination-step", currentPage === 1 && "is-disabled"]}
        href={currentPage > 1 ? pageHref(currentPage - 1) : undefined}
        aria-disabled={currentPage === 1 ? "true" : undefined}
      >
        {isZh ? "上一页" : "Previous"}
      </a>

      <ol>
        {pageNumbers.map((page) => (
          <li>
            <a
              class:list={[page === currentPage && "is-current"]}
              href={pageHref(page)}
              aria-current={page === currentPage ? "page" : undefined}
            >
              {page}
            </a>
          </li>
        ))}
      </ol>

      <a
        class:list={["pagination-step", currentPage === totalPages && "is-disabled"]}
        href={currentPage < totalPages ? pageHref(currentPage + 1) : undefined}
        aria-disabled={currentPage === totalPages ? "true" : undefined}
      >
        {isZh ? "下一页" : "Next"}
      </a>
    </nav>
  )
}

