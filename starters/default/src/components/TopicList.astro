---
import { getHomeTopics, getHomeTopicsHeading, sitePath } from "../config";
import type { ContentEntry } from "../lib/content";

type Props = {
  locale: string;
  posts: ContentEntry[];
};

const { locale, posts } = Astro.props;
const topics = getHomeTopics(locale).map((topic) => ({
  ...topic,
  postCount: posts.filter((post) => post.topic === topic.id).length
}));
const heading = getHomeTopicsHeading(locale);
const isZh = locale === "zh";

function articleCount(count: number) {
  if (isZh) {
    return `${count} 篇文章`;
  }

  return `${count} ${count === 1 ? "article" : "articles"}`;
}
---

{
  topics.length > 0 && (
    <section class="topic-section" aria-labelledby="topic-section-title">
      <div class="section-header">
        <h2 id="topic-section-title">{heading}</h2>
      </div>
      <div class="topic-list">
        {topics.map((topic) => (
          <a class="topic-row" href={sitePath(topic.href)} data-topic-id={topic.id}>
            <span class="topic-copy">
              <strong>{topic.title}</strong>
              {topic.summary && <span>{topic.summary}</span>}
            </span>
            <span class="topic-count">{articleCount(topic.postCount)}</span>
            <span class="topic-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  )
}
