---
import HomePage from "../components/HomePage.astro";
import RedirectPage from "../components/RedirectPage.astro";
import { getLocaleBase, siteConfig } from "../config";

const redirectTarget = siteConfig.prefixDefaultLocale ? `${getLocaleBase(siteConfig.defaultLocale)}/` : undefined;
---

{redirectTarget ? <RedirectPage to={redirectTarget} /> : <HomePage locale={siteConfig.defaultLocale} />}
