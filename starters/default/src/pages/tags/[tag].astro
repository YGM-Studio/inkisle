---
import RedirectPage from "../../components/RedirectPage.astro";
import { getLocaleBase, siteConfig } from "../../config";
import { getTagIndex } from "../../lib/content";
import { getActiveTheme } from "../../themes/registry";

export async function getStaticPaths() {
  const tags = await getTagIndex(siteConfig.defaultLocale);

  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag }
  }));
}

const { tag } = Astro.props;
const redirectTarget = siteConfig.prefixDefaultLocale
  ? `${getLocaleBase(siteConfig.defaultLocale)}/tags/${tag.slug}/`
  : undefined;
const TaxonomyPage = (await getActiveTheme(siteConfig.theme.name)).components.TaxonomyPage;
---

{
  redirectTarget ? (
    <RedirectPage to={redirectTarget} />
  ) : (
    <TaxonomyPage locale={siteConfig.defaultLocale} item={tag} type="tag" />
  )
}
