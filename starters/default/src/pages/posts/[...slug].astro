---
import RedirectPage from "../../components/RedirectPage.astro";
import { siteConfig } from "../../config";
import { getPosts } from "../../lib/content";
import { getRelatedPosts } from "../../lib/related-posts";
import { getActiveTheme } from "../../themes/registry";

export async function getStaticPaths() {
  const posts = await getPosts(siteConfig.defaultLocale);

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, relatedPosts: getRelatedPosts(post, posts) }
  }));
}

const { post, relatedPosts } = Astro.props;
const redirectTarget = siteConfig.prefixDefaultLocale ? post.url : undefined;
const PostLayout = (await getActiveTheme(siteConfig.theme.name)).components.PostLayout;
---

{redirectTarget ? <RedirectPage to={redirectTarget} /> : <PostLayout post={post} relatedPosts={relatedPosts} />}
