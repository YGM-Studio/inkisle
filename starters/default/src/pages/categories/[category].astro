---
import RedirectPage from "../../components/RedirectPage.astro";
import { getLocaleBase, siteConfig } from "../../config";
import { getCategoryIndex } from "../../lib/content";
import { getActiveTheme } from "../../themes/registry";

export async function getStaticPaths() {
  const categories = await getCategoryIndex(siteConfig.defaultLocale);

  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category }
  }));
}

const { category } = Astro.props;
const redirectTarget = siteConfig.prefixDefaultLocale
  ? `${getLocaleBase(siteConfig.defaultLocale)}/categories/${category.slug}/`
  : undefined;
const TaxonomyPage = (await getActiveTheme(siteConfig.theme.name)).components.TaxonomyPage;
---

{
  redirectTarget ? (
    <RedirectPage to={redirectTarget} />
  ) : (
    <TaxonomyPage locale={siteConfig.defaultLocale} item={category} type="category" />
  )
}
