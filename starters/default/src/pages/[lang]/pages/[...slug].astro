---
import RedirectPage from "../../../components/RedirectPage.astro";
import { getLocaleCodes, shouldRedirectDefaultLocalePrefix, siteConfig } from "../../../config";
import { getPages, type ContentEntry } from "../../../lib/content";
import { getActiveTheme } from "../../../themes/registry";

export async function getStaticPaths() {
  const paths = [];

  for (const lang of getLocaleCodes()) {
    const pages = await getPages(lang);
    paths.push(
      ...pages.map((page) => ({
        params: { lang, slug: page.slug },
        props: { page }
      }))
    );
  }

  return paths;
}

const { page } = Astro.props as { page: ContentEntry };
const redirectTarget = shouldRedirectDefaultLocalePrefix(page.locale) ? page.url : undefined;
const MarkdownPage = (await getActiveTheme(siteConfig.theme.name)).components.MarkdownPage;
---

{redirectTarget ? <RedirectPage to={redirectTarget} /> : <MarkdownPage page={page} />}
