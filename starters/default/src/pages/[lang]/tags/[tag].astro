---
import RedirectPage from "../../../components/RedirectPage.astro";
import TaxonomyPage from "../../../components/TaxonomyPage.astro";
import { getLocaleBase, getLocaleCodes, shouldRedirectDefaultLocalePrefix } from "../../../config";
import { getTagIndex } from "../../../lib/content";

export async function getStaticPaths() {
  const paths = [];

  for (const lang of getLocaleCodes()) {
    const tags = await getTagIndex(lang);
    paths.push(
      ...tags.map((tag) => ({
        params: { lang, tag: tag.slug },
        props: { tag }
      }))
    );
  }

  return paths;
}

const { lang } = Astro.params;
const { tag } = Astro.props;
const redirectTarget = shouldRedirectDefaultLocalePrefix(lang) ? `${getLocaleBase(lang)}/tags/${tag.slug}/` : undefined;
---

{redirectTarget ? <RedirectPage to={redirectTarget} /> : <TaxonomyPage locale={lang} item={tag} type="tag" />}
