---
import PostArchivePage from "../../../components/PostArchivePage.astro";
import RedirectPage from "../../../components/RedirectPage.astro";
import { getLocaleBase, getLocaleCodes, shouldRedirectDefaultLocalePrefix } from "../../../config";
import { getPosts } from "../../../lib/content";
import { paginate } from "../../../lib/pagination";

export async function getStaticPaths() {
  const paths = [];

  for (const lang of getLocaleCodes()) {
    const posts = await getPosts(lang);
    const totalPages = paginate(posts, 1).totalPages;

    for (let page = 2; page <= totalPages; page += 1) {
      paths.push({
        params: { lang, page: String(page) },
        props: { pageNumber: page }
      });
    }
  }

  return paths;
}

const { lang } = Astro.params;
const { pageNumber } = Astro.props;
const redirectTarget = shouldRedirectDefaultLocalePrefix(lang) ? `${getLocaleBase(lang)}/page/${pageNumber}/` : undefined;
---

{redirectTarget ? <RedirectPage to={redirectTarget} /> : <PostArchivePage locale={lang} pageNumber={pageNumber} />}
