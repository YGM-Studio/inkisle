---
import RedirectPage from "../../components/RedirectPage.astro";
import SearchPage from "../../components/SearchPage.astro";
import { getLocaleBase, getLocaleCodes, shouldRedirectDefaultLocalePrefix } from "../../config";

export async function getStaticPaths() {
  return getLocaleCodes().map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const redirectTarget = shouldRedirectDefaultLocalePrefix(lang) ? `${getLocaleBase(lang)}/search/` : undefined;
---

{redirectTarget ? <RedirectPage to={redirectTarget} /> : <SearchPage locale={lang} />}
