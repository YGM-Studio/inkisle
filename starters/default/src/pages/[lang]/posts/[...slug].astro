---
import RedirectPage from "../../../components/RedirectPage.astro";
import PostLayout from "../../../layouts/PostLayout.astro";
import { shouldRedirectDefaultLocalePrefix, getLocaleCodes } from "../../../config";
import { getPosts } from "../../../lib/content";

export async function getStaticPaths() {
  const paths = [];

  for (const lang of getLocaleCodes()) {
    const posts = await getPosts(lang);
    paths.push(
      ...posts.map((post) => ({
        params: { lang, slug: post.slug },
        props: { post }
      }))
    );
  }

  return paths;
}

const { post } = Astro.props;
const redirectTarget = shouldRedirectDefaultLocalePrefix(post.locale) ? post.url : undefined;
---

{redirectTarget ? <RedirectPage to={redirectTarget} /> : <PostLayout post={post} />}
