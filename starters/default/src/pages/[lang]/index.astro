---
import HomePage from "../../components/HomePage.astro";
import RedirectPage from "../../components/RedirectPage.astro";
import { getLocaleBase, getLocaleCodes, shouldRedirectDefaultLocalePrefix } from "../../config";

export async function getStaticPaths() {
  return getLocaleCodes().map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const redirectTarget = shouldRedirectDefaultLocalePrefix(lang) ? `${getLocaleBase(lang)}/` : undefined;
---

{redirectTarget ? <RedirectPage to={redirectTarget} /> : <HomePage locale={lang} />}
