---
import RedirectPage from "../../../components/RedirectPage.astro";
import { getLocaleBase, getLocaleCodes, shouldRedirectDefaultLocalePrefix, siteConfig } from "../../../config";
import { getCategoryIndex } from "../../../lib/content";
import { getActiveTheme } from "../../../themes/registry";

export async function getStaticPaths() {
  const paths = [];

  for (const lang of getLocaleCodes()) {
    const categories = await getCategoryIndex(lang);
    paths.push(
      ...categories.map((category) => ({
        params: { lang, category: category.slug },
        props: { category }
      }))
    );
  }

  return paths;
}

const { lang } = Astro.params;
const { category } = Astro.props;
const redirectTarget = shouldRedirectDefaultLocalePrefix(lang) ? `${getLocaleBase(lang)}/categories/${category.slug}/` : undefined;
const TaxonomyPage = (await getActiveTheme(siteConfig.theme.name)).components.TaxonomyPage;
---

{redirectTarget ? <RedirectPage to={redirectTarget} /> : <TaxonomyPage locale={lang} item={category} type="category" />}
