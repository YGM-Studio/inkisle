---
import BaseLayout from "./BaseLayout.astro";
import InteractionSection from "../../../components/interactions/InteractionSection.astro";
import TopicCallout from "../../../components/TopicCallout.astro";
import { getLocaleBase, getTopic, sitePath } from "../../../config";
import { categoryHref, formatDate, tagHref, type ContentEntry } from "../../../lib/content";

type Props = {
  post: ContentEntry;
};

const { post } = Astro.props;
const isZh = post.locale === "zh";
const localeBase = getLocaleBase(post.locale);
const topic = post.topic ? getTopic(post.topic, post.locale) : undefined;
---

<BaseLayout
  title={post.title}
  description={post.summary || post.excerpt}
  locale={post.locale}
  canonicalPath={post.url}
>
  <article class="article-shell">
    <header class="article-hero">
      <span class="eyebrow">{post.category || (isZh ? "洞察" : "Insight")}</span>
      <h1>{post.title}</h1>
      <div class="article-meta">
        {post.date && <time datetime={post.date}>{formatDate(post.date, post.locale)}</time>}
        {post.updated && <span>{isZh ? "更新于" : "Updated"} {formatDate(post.updated, post.locale)}</span>}
        {post.category && <a href={categoryHref(post.locale, post.category)}>{post.category}</a>}
      </div>
      {post.summary && <p class="article-summary">{post.summary}</p>}
      {
        post.tags.length > 0 && (
          <nav class="tag-row" aria-label="Tags">
            {post.tags.map((tag) => (
              <a href={tagHref(post.locale, tag)}>{tag}</a>
            ))}
          </nav>
        )
      }
    </header>

    <div class="prose" set:html={post.html} />

    {
      topic ? (
        <TopicCallout locale={post.locale} topic={topic} />
      ) : (
        <section class="article-cta" aria-label={isZh ? "继续浏览" : "Continue browsing"}>
          <div>
            <span>{isZh ? "继续探索" : "More insight"}</span>
            <h2>{isZh ? "查找更多相关内容" : "Find more relevant content"}</h2>
          </div>
          <a href={sitePath(`${localeBase}/search/`)}>
            {isZh ? "搜索资源" : "Search resources"}
          </a>
        </section>
      )
    }

    <InteractionSection post={post} />
  </article>
</BaseLayout>
