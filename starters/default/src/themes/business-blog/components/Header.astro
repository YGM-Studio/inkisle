---
import ThemeToggle from "./ThemeToggle.astro";
import { getLocaleBase, getLocaleLabel, getTopics, getTopicsLabel, siteConfig, sitePath } from "../../../config";
import { getPages } from "../../../lib/content";

type Props = {
  locale: string;
};

const { locale } = Astro.props;
const isZh = locale === "zh";
const pages = await getPages(locale);
const aboutPage = pages.find((page) => page.slug === "about");
const navItems = [
  { href: sitePath(`${getLocaleBase(locale)}/`), label: isZh ? "洞察" : "Insights" },
];

if (getTopics(locale).length > 0) {
  navItems.push({ href: sitePath(`${getLocaleBase(locale)}/topics/`), label: getTopicsLabel(locale) });
}

navItems.push({ href: sitePath(`${getLocaleBase(locale)}/search/`), label: isZh ? "资源搜索" : "Search" });

if (aboutPage) {
  navItems.push({ href: sitePath(aboutPage.url), label: isZh ? "关于" : "About" });
}

const brandSubtitle = siteConfig.brand.subtitle || siteConfig.author.name;
const compactLocaleSelector = siteConfig.locales.length > 2;
---

<header class="site-header">
  <div class="header-frame">
    <a class="brand" href={sitePath(`${getLocaleBase(locale)}/`)} aria-label={siteConfig.title}>
      <span class="brand-mark" aria-hidden="true">{siteConfig.brand.mark}</span>
      <span class="brand-copy">
        <strong>{siteConfig.title}</strong>
        {brandSubtitle && <small>{brandSubtitle}</small>}
      </span>
    </a>

    <nav class="main-nav" aria-label="Primary">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      {
        compactLocaleSelector ? (
          <details class="locale-menu">
            <summary>{getLocaleLabel(locale)}</summary>
            <nav aria-label="Languages">
              {siteConfig.locales.map((item) => (
                <a class:list={[item.code === locale && "is-active"]} href={sitePath(`${getLocaleBase(item.code)}/`)}>
                  {getLocaleLabel(item.code)}
                </a>
              ))}
            </nav>
          </details>
        ) : (
          <nav class="locale-nav" aria-label="Languages">
            {siteConfig.locales.map((item) => (
              <a class:list={[item.code === locale && "is-active"]} href={sitePath(`${getLocaleBase(item.code)}/`)}>
                {getLocaleLabel(item.code)}
              </a>
            ))}
          </nav>
        )
      }
      <ThemeToggle locale={locale} />
      <a class="header-cta" href={sitePath("/rss.xml")}>{isZh ? "订阅" : "Subscribe"}</a>
    </div>
  </div>
</header>
