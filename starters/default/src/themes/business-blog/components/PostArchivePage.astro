---
import BaseLayout from "../layouts/BaseLayout.astro";
import Pagination from "./Pagination.astro";
import PostList from "./PostList.astro";
import { getLocaleBase } from "../../../config";
import { getPosts } from "../../../lib/content";
import { paginate } from "../../../lib/pagination";

type Props = {
  locale: string;
  pageNumber: number;
};

const { locale, pageNumber } = Astro.props;
const posts = await getPosts(locale);
const page = paginate(posts, pageNumber);
const isZh = locale === "zh";
---

<BaseLayout
  title={isZh ? `文章第 ${page.currentPage} 页` : `Posts Page ${page.currentPage}`}
  description={isZh ? "继续浏览文章归档。" : "Continue browsing posts."}
  locale={locale}
  canonicalPath={`${getLocaleBase(locale)}/page/${page.currentPage}/`}
>
  <section class="listing-shell" aria-labelledby="paged-posts">
    <header class="page-title">
      <span class="eyebrow">{isZh ? "资源库" : "Resource Library"}</span>
      <h1 id="paged-posts">{isZh ? `第 ${page.currentPage} 页` : `Page ${page.currentPage}`}</h1>
      <p>
        {
          isZh
            ? `共 ${page.totalItems} 篇文章，当前显示第 ${page.currentPage} / ${page.totalPages} 页。`
            : `${page.totalItems} posts, page ${page.currentPage} of ${page.totalPages}.`
        }
      </p>
    </header>

    <PostList posts={page.items} />
    <Pagination locale={locale} currentPage={page.currentPage} totalPages={page.totalPages} />
  </section>
</BaseLayout>
