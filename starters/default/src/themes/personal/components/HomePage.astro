---
import BaseLayout from "../layouts/BaseLayout.astro";
import Pagination from "./Pagination.astro";
import PostList from "./PostList.astro";
import { getLocaleBase, getSiteDescription } from "../../../config";
import { getPosts } from "../../../lib/content";
import { paginate } from "../../../lib/pagination";

type Props = {
  locale: string;
};

const { locale } = Astro.props;
const posts = await getPosts(locale);
const page = paginate(posts, 1);
const isZh = locale === "zh";
const homeDescription = getSiteDescription(locale);
---

<BaseLayout locale={locale} canonicalPath={`${getLocaleBase(locale)}/`} description={homeDescription}>
  <section class="home-intro" aria-labelledby="home-intro-title">
    <h1 id="home-intro-title">{homeDescription}</h1>
  </section>

  <section aria-labelledby="latest-posts">
    <div class="section-header">
      <h2 id="latest-posts">{isZh ? "最新文章" : "Latest Posts"}</h2>
    </div>
    <PostList posts={page.items} emptyLabel={isZh ? "还没有公开文章。" : "No published posts yet."} />
    <Pagination locale={locale} currentPage={page.currentPage} totalPages={page.totalPages} />
  </section>
</BaseLayout>
