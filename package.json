{
  "name": "inkisle",
  "version": "0.0.18",
  "type": "module",
  "description": "AI-native Markdown publishing system built on Astro and Vite.",
  "license": "MIT",
  "author": "YGM Studio",
  "homepage": "https://github.com/YGM-Studio/inkisle#readme",
  "bugs": {
    "url": "https://github.com/YGM-Studio/inkisle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YGM-Studio/inkisle.git"
  },
  "keywords": [
    "astro",
    "markdown",
    "static-site",
    "publishing",
    "blog",
    "llms-txt",
    "ai-native"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "inkisle": "bin/inkisle.mjs"
  },
  "files": [
    "bin/",
    "docs/",
    "starters/content-only/content/",
    "starters/content-only/gitignore",
    "starters/content-only/package.json",
    "starters/content-only/README.md",
    "starters/default/astro.config.mjs",
    "starters/default/content/",
    "starters/default/gitignore",
    "starters/default/package.json",
    "starters/default/public/",
    "starters/default/README.md",
    "starters/default/src/",
    "starters/default/tsconfig.json"
  ],
  "workspaces": [
    "starters/default"
  ],
  "scripts": {
    "dev": "npm run -w @inkisle/starter-default dev",
    "build": "npm run -w @inkisle/starter-default build",
    "check": "npm run -w @inkisle/starter-default check",
    "check:links": "node bin/inkisle.mjs check links --dist starters/default/dist",
    "test:interactions": "node --test tests/interactions.test.mjs",
    "test:topics": "node --test tests/topics.test.mjs",
    "site:build": "cd site && npm run build",
    "site:check:links": "cd site && npm run check:links",
    "ci": "npm run check && npm run test:interactions && npm run test:topics && npm run build && npm run check:links && npm run site:build && npm run site:check:links && npm audit --audit-level=high",
    "preview": "npm run -w @inkisle/starter-default preview",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.3",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.1"
  },
  "overrides": {
    "yaml": "^2.8.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
